{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniDoku",
  "version": "0.1.0",
  "identifier": "com.anidoku.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AniDoku",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0e11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' stream: https: data: asset: http://asset.localhost; media-src 'self' stream: https: blob:; connect-src 'self' stream: https: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
