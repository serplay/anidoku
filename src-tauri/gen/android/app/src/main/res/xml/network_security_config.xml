<?xml version="1.0" encoding="utf-8"?>
<!-- The in-app media server (playback + offline files) and the OAuth loopback
     capture listen on plain HTTP at 127.0.0.1. Release builds set
     usesCleartextTraffic=false, which would block them without this loopback
     exemption. Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
